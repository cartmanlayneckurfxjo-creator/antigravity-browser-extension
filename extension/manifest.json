{
  "manifest_version": 3,
  "name": "Antigravity Browser Bridge",
  "short_name": "AGY Browser",
  "version": "0.1.0",
  "description": "Connects your browser to Antigravity IDE via MCP for AI-powered browser analysis and automation.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Antigravity Browser Bridge"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
